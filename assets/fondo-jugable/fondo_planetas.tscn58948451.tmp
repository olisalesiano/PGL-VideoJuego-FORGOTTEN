[sub_resource type="GDScript" id="GDScript_mxyds"]
script/source = "extends Node2D

const VELOCIDAD = 6.7
const DISTANCIA = 200.0

var direccion := 1.0
var pos_inicio : float

func _ready() -> void:
	pos_inicio = position.x

func _process(delta: float) -> void:
	position.x += VELOCIDAD * direccion * delta

	# Al llegar al límite, invertir dirección
	if position.x >= pos_inicio + DISTANCIA:
		direccion = -1.0
	elif position.x <= pos_inicio - DISTANCIA:
		direccion = 1.0
"

